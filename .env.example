# Leave blank to keep the isolated local demo. Set these in Vercel for private mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use familyos for supabase/shared-setup.sql; public for standalone supabase/setup.sql.
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=public
# Enable administrator Google / staff username UI after managed-access migration.
NEXT_PUBLIC_FAMILYOS_MANAGED_ACCESS=false
NEXT_PUBLIC_APP_URL=https://family-os-liard-six.vercel.app

# Server only. NEVER prefix with NEXT_PUBLIC_. Used solely by the invitation API.
SUPABASE_SERVICE_ROLE_KEY=

# Optional staging verification, stored only in an ignored .env.test.local.
# FAMILYOS_TEST_JUAN_EMAIL=
# FAMILYOS_TEST_JUAN_PASSWORD=
# FAMILYOS_TEST_PAMELA_EMAIL=
# FAMILYOS_TEST_PAMELA_PASSWORD=
# FAMILYOS_TEST_COLLAB_EMAIL=
# FAMILYOS_TEST_COLLAB_PASSWORD=
# FAMILYOS_TEST_OTHER_EMAIL=
# FAMILYOS_TEST_OTHER_PASSWORD=
# FAMILYOS_LIVE_TEST_WRITE=1
